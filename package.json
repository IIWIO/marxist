{
  "name": "marxist",
  "version": "0.8.2",
  "description": "A beautiful macOS markdown editor with AI assistance",
  "main": "out/main/index.js",
  "author": "Marxist Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "ELECTRON_RUN_AS_NODE= electron-vite dev",
    "build": "electron-vite build",
    "preview": "ELECTRON_RUN_AS_NODE= electron-vite preview",
    "start": "ELECTRON_RUN_AS_NODE= electron .",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run typecheck && npm run lint && npm run test:coverage",
    "verify": "npm run check && npm run build",
    "build:mac": "npm run check && electron-vite build && electron-builder --mac",
    "publish:mac": "npm run check && electron-vite build && electron-builder --mac --publish always"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.15",
    "@eslint/js": "^9.39.0",
    "@lezer/highlight": "^1.2.3",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "5.0.0",
    "autoprefixer": "^10.4.16",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "github-markdown-css": "^5.9.0",
    "jsdom": "^30.0.1",
    "katex": "^0.18.7",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "unified": "^11.0.5",
    "vite": "^7.3.6",
    "vitest": "5.0.0",
    "zustand": "^5.0.15"
  }
}
